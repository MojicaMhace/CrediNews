rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. Helper Function: Check Authentication Status (No Change) ---
    function isAuthenticatedAndVerified() {
      // User must be logged in AND their email must be verified on the Auth server
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    // --- 2. Core User/Auth Rules (The original user doc) ---
    // User must always be able to read/create their OWN profile.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow update only if:
      // a) The user owns the document.
      // b) The update is allowed (e.g., changing emailVerified from false to true, or only updating name/preferences).
      allow update: if request.auth != null 
                        && request.auth.uid == userId
                        && (
                            // Case 1: Allow emailVerified to change from false to true OR remain unchanged
                            (
                                resource.data.emailVerified == false 
                                && request.resource.data.emailVerified == true
                            )
                            || (
                                request.resource.data.emailVerified == resource.data.emailVerified
                            )
                        )
                        // c) Prevent tampering with critical fields like role or provider (MUST be done for security)
                        && (
                             (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role)
                            && (!request.resource.data.keys().hasAny(['provider']) || request.resource.data.provider == resource.data.provider)
                        );
    }
    
    // --- 3. Verification & Poseur Detection (Verified WRITE Access Only) ---
    // These are the collections where WRITE access MUST be restricted to verified users.
    match /facebook_verification_results/{docId} { 
      allow read: if true; // Public/Guest Read
      allow write: if isAuthenticatedAndVerified(); // Only Verified users can WRITE
    }
    
    match /poser_detections/{docId} { 
      allow read: if true; // Public/Guest Read
      allow write: if isAuthenticatedAndVerified(); // Only Verified users can WRITE
    }

    match /notifications/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if isAuthenticatedAndVerified() && request.auth.uid == request.resource.data.userId;
    }

    // --- 4. Other Public Collections ---
    match /trends/{trendId} { 
      allow read: if true; // Public/Guest Read
      allow write: if isAuthenticatedAndVerified(); // Only Verified users can WRITE
    }
    
    // --- 5. Private User History Collections (Verified READ and WRITE Access) ---
    // Assuming only verified users should see or update their own pending verifications
    match /pending_news_verification/{docId} {
      allow read, write: if isAuthenticatedAndVerified(); 
    }
    
    // --- 6. DEFAULT BLOCK ---
    // This is the safety net. By removing the {document=**} from the block above,
    // any other undeclared collection is completely blocked by default.
  }
}
