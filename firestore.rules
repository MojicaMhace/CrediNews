rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticatedAndVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isAdminOrVerified() {
      return request.auth != null && (
          request.auth.token.email_verified == true || 
          request.auth.token.email == 'admin@credinews.com'
      );
    }

    // --- MISSING RULE FIX ---
    // Allow users (even anonymous ones based on your JS logic) to create verification requests
    match /facebook_verification_requests/{docId} {
      allow create: if true; 
      allow read: if isAdminOrVerified(); 
    }

    // --- MERGED & FIXED RULE ---
    // Consolidated duplicate entries for this collection
    match /facebook_verification_results/{docId} { 
      allow read: if true;
      allow write: if isAdminOrVerified(); 
    }
    
    // Admin & Queue Collections
    match /pending_verifications/{docId} {
      allow read, write: if isAdminOrVerified();
    }

    match /pending_news_verification/{docId} {
      allow read, write: if isAuthenticatedAndVerified();
    }

    match /verified_registry/{docId} {
      allow read: if true;
      allow write: if isAdminOrVerified();
    }
    
    // User Profiles
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      // Publicly readable if the user is verified; otherwise only the owner can read
      allow read: if (resource.data.emailVerified == true) || (request.auth != null && request.auth.uid == userId);
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && (
                        (resource.data.emailVerified == false && request.resource.data.emailVerified == true) || 
                        (request.resource.data.emailVerified == resource.data.emailVerified)
                    )
                    && (
                         (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role)
                        && (!request.resource.data.keys().hasAny(['provider']) || request.resource.data.provider == resource.data.provider)
                    );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    match /poser_detections/{docId} { 
      allow read: if true;
      allow write: if isAuthenticatedAndVerified();
    }

    match /trends/{trendId} { 
      allow read: if true;
      allow write: if isAuthenticatedAndVerified();
    }
    
    match /analyzed_pages_cache/{docId} {
       allow read: if true;
       allow write: if false; 
    }
  }
}
